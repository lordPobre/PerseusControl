# ══════════════════════════════════════════════════════════════
# Perseus Control v4 — Variables de entorno
# Copiar como .env y completar con valores reales.
# NUNCA subir .env al repositorio.
# ══════════════════════════════════════════════════════════════

# Django
SECRET_KEY=genera-una-clave-de-50-chars-aqui
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Base de datos
# Desarrollo: dejar en blanco para usar SQLite automáticamente
# Producción Railway/Render: pegar la DATABASE_URL que te dan
DATABASE_URL=

# Cloudinary (fotos de marcajes y logos)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Email Gmail (crear App Password en myaccount.google.com/security)
EMAIL_HOST_USER=tu@gmail.com
EMAIL_HOST_PASSWORD=xxxx_xxxx_xxxx_xxxx
DEFAULT_FROM_EMAIL=Perseus Control <tu@gmail.com>

# Gemini AI (console.cloud.google.com)
GEMINI_API_KEY=tu_gemini_key

# Entorno (development / production)
ENVIRONMENT=development

# Redis (Celery broker)
# Local: instalar Redis en Windows https://github.com/microsoftarchive/redis/releases
# Railway/Render: agregar servicio Redis y copiar la URL automáticamente
REDIS_URL=redis://localhost:6379/0
